PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/placement_portal
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# AI provider (Anthropic Messages API). Without a key, AI endpoints return a clear 503 error
# instead of fake output; everything else in the app keeps working.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
